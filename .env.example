# Gemini (optional). Without a key, AI actions return clearly labelled placeholders.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Server
PORT=3000
APP_URL="http://localhost:3000"

# Storage (SQLite). Defaults to ./data/qalab.db
# DATA_DIR="./data"

# Auth. The first account created becomes the admin.
# ALLOW_SIGNUP=true      # let anyone register as a member (default: admins add people)
# AUTH_DISABLED=true     # local single-user mode only; refused when NODE_ENV=production
# COOKIE_SECURE=true     # set when serving over HTTPS (always on in production)
